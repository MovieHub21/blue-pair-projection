# Public (safe to ship to the browser) — Supabase project connection.
NEXT_PUBLIC_SUPABASE_URL="https://jyllymseodyvuzkatdzp.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="<anon/publishable key from Supabase Project Settings → API>"

# Public site URL used for Paystack callbacks and canonical links.
NEXT_PUBLIC_SITE_URL="https://www.bluepairhotel.com"

# SERVER-ONLY SECRET — never prefix with NEXT_PUBLIC_, never commit a real value, never expose to the browser.
# Required for /api/admin/create-staff and scheduled guest email jobs.
SUPABASE_SERVICE_ROLE_KEY="<service role key — keep this secret>"

# Paystack — server only. Use a test key during development and a live key in production.
PAYSTACK_SECRET_KEY="<Paystack secret key>"

# Resend — server only. Never expose either value to the browser.
# RESEND_FROM_EMAIL must be a verified sender/domain in Resend.
RESEND_API_KEY="<Resend API key>"
RESEND_FROM_EMAIL="Blue Pair Hotel <reservations@your-verified-domain.com>"

# Server-only secret used to authorize /api/cron/guest-emails.
CRON_SECRET="<long-random-secret>"
